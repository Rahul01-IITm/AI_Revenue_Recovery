# --- Secrets: Razorpay test keys, LLM API keys. Never commit. ---
.env
.env.*
!.env.example
*.pem
secrets.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Testing / tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Audit store & generated batches ---
# Schema and generator are code and ARE committed; their outputs are not.
# Reproducibility comes from SEED=42, not from checking in artefacts.
*.db
*.sqlite
*.sqlite3
*.db-journal
/data/batches/
/data/generated/
*.parquet

# --- Reports & run outputs ---
/report/out/
/report/*.html
run_*.log
*.log

# --- Notebooks ---
.ipynb_checkpoints/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Streamlit ---
.streamlit/secrets.toml
